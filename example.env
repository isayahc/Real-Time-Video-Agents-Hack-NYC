# Copy these values into your shell environment before running live inference.
# Do not commit real credentials.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_KEY=

# Automatic research and intervention selection in the process workspace.
TAVILY_API_KEY=
GMI_API_KEY=
# Optional; defaults to the scripted E2E text-model setting.
GMI_MODEL=

# Hugging Face downloads for the local GR00T diagnostic (including gated Cosmos).
# Accept the model's access terms and enable public gated repository read access.
HF_TOKEN=

# Presets are also built in; blank values use these defaults.
# Explicit overrides require compatible models available to your account.
NEBIUS_VISION_MODEL=MiniMaxAI/MiniMax-M3
NEBIUS_COMPILER_MODEL=nvidia/Nemotron-3_5-Lightning

