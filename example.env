# Copy these values into your shell environment before running live inference.
# Do not commit real credentials.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_KEY=

# Set these to model IDs available in your Nebius Token Factory catalog.
# Override the workbench preset if your account requires another vision model.
NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
NEBIUS_COMPILER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

