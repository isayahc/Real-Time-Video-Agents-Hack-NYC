{
  "$defs": {
    "AttendanceInterval": {
      "additionalProperties": false,
      "description": "Sourced attended labor interval, in seconds from the batch origin.",
      "properties": {
        "operator_id": {
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "basis": {
          "enum": [
            "measured",
            "assumed"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "start_s",
        "end_s",
        "basis",
        "source"
      ],
      "title": "AttendanceInterval",
      "type": "object"
    },
    "ComparisonResult": {
      "additionalProperties": false,
      "description": "Conditional economics with explicit evidence and capacity gates.",
      "properties": {
        "status": {
          "enum": [
            "calculated",
            "insufficient_evidence",
            "infeasible_capacity",
            "unsupported_horizon"
          ],
          "title": "Status",
          "type": "string"
        },
        "decision": {
          "enum": [
            "candidate_lower_cost",
            "baseline_lower_cost",
            "equal_cost",
            "undetermined"
          ],
          "title": "Decision",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "object"
        },
        "horizon_break_even_direction": {
          "enum": [
            "above",
            "below",
            "all_volumes",
            "no_volumes",
            "unknown"
          ],
          "title": "Horizon Break Even Direction",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "assumptions_present": {
          "title": "Assumptions Present",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "decision",
        "metrics",
        "horizon_break_even_direction",
        "issues",
        "assumptions_present"
      ],
      "title": "ComparisonResult",
      "type": "object"
    },
    "EngineeringValue": {
      "additionalProperties": false,
      "description": "An explicitly supplied measurement, specification or planning assumption.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "enum": [
            "unknown",
            "measured",
            "supplier_specification",
            "assumed"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "unit",
        "basis"
      ],
      "title": "EngineeringValue",
      "type": "object"
    },
    "InvestmentComparisonInput": {
      "additionalProperties": false,
      "description": "Comparable outputs, annual demand and a no-replacement analysis horizon.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "baseline": {
          "$ref": "#/$defs/InvestmentOption"
        },
        "candidate": {
          "$ref": "#/$defs/InvestmentOption"
        },
        "equivalence_verified": {
          "default": false,
          "title": "Equivalence Verified",
          "type": "boolean"
        },
        "equivalence_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equivalence Source"
        },
        "annual_demand": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "horizon_years": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/SensitivityScenario"
          },
          "title": "Scenarios",
          "type": "array"
        }
      },
      "required": [
        "baseline",
        "candidate",
        "annual_demand",
        "horizon_years"
      ],
      "title": "InvestmentComparisonInput",
      "type": "object"
    },
    "InvestmentOption": {
      "additionalProperties": false,
      "description": "A process option with disjoint variable, fixed and upfront cost boundaries.",
      "properties": {
        "process": {
          "$ref": "#/$defs/ProcessEvaluationInput"
        },
        "cost_model_source": {
          "minLength": 1,
          "title": "Cost Model Source",
          "type": "string"
        },
        "capacity_model_source": {
          "minLength": 1,
          "title": "Capacity Model Source",
          "type": "string"
        },
        "upfront": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "title": "Upfront",
          "type": "object"
        },
        "annual_fixed_cost": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "scheduled_hours": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "utilization": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "downtime": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "useful_life": {
          "$ref": "#/$defs/EngineeringValue"
        }
      },
      "required": [
        "process",
        "cost_model_source",
        "capacity_model_source",
        "annual_fixed_cost",
        "scheduled_hours",
        "utilization",
        "downtime",
        "useful_life"
      ],
      "title": "InvestmentOption",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A calculated value, or an explicit explanation of why it is unknown.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "calculated",
            "unknown",
            "undefined"
          ],
          "title": "Status",
          "type": "string"
        },
        "basis": {
          "enum": [
            "derived_from_sourced_inputs",
            "includes_assumptions",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "value",
        "unit",
        "status",
        "basis",
        "dependencies"
      ],
      "title": "Metric",
      "type": "object"
    },
    "ProcessEvaluationInput": {
      "additionalProperties": false,
      "description": "One batch with explicit units, boundary and acceptance provenance.\n\nMissing inputs remain unknown. Attendance intervals or an aggregate labor\nvalue may be supplied, never both. Rates must match the report's USD currency.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "configuration_id": {
          "minLength": 1,
          "title": "Configuration Id",
          "type": "string"
        },
        "functional_unit": {
          "minLength": 1,
          "title": "Functional Unit",
          "type": "string"
        },
        "boundary": {
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "acceptance_verified": {
          "default": false,
          "title": "Acceptance Verified",
          "type": "boolean"
        },
        "acceptance_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Source"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "attendance": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AttendanceInterval"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance"
        },
        "attendance_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance Source"
        }
      },
      "required": [
        "configuration_id",
        "functional_unit",
        "boundary"
      ],
      "title": "ProcessEvaluationInput",
      "type": "object"
    },
    "SensitivityScenario": {
      "additionalProperties": false,
      "description": "Named, sourced overrides to the same underlying investment comparison.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "minProperties": 1,
          "title": "Overrides",
          "type": "object"
        }
      },
      "required": [
        "name",
        "overrides"
      ],
      "title": "SensitivityScenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned base and sensitivity results retaining the complete input snapshot.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "comparator_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Comparator Version",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/ComparisonResult"
    },
    "scenarios": {
      "additionalProperties": {
        "$ref": "#/$defs/ComparisonResult"
      },
      "title": "Scenarios",
      "type": "object"
    },
    "input_snapshot": {
      "$ref": "#/$defs/InvestmentComparisonInput"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "base",
    "scenarios",
    "input_snapshot",
    "limitations"
  ],
  "title": "InvestmentComparisonReport",
  "type": "object"
}
