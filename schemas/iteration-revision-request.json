{
  "$defs": {
    "AttendanceInterval": {
      "additionalProperties": false,
      "description": "Sourced attended labor interval, in seconds from the batch origin.",
      "properties": {
        "operator_id": {
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "basis": {
          "enum": [
            "measured",
            "assumed"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "start_s",
        "end_s",
        "basis",
        "source"
      ],
      "title": "AttendanceInterval",
      "type": "object"
    },
    "DeviationTolerance": {
      "additionalProperties": false,
      "description": "Absolute metric-unit and relative-fraction thresholds; use the larger.",
      "properties": {
        "absolute": {
          "default": 0,
          "minimum": 0,
          "title": "Absolute",
          "type": "number"
        },
        "relative": {
          "default": 0.1,
          "minimum": 0,
          "title": "Relative",
          "type": "number"
        }
      },
      "title": "DeviationTolerance",
      "type": "object"
    },
    "EngineeringValue": {
      "additionalProperties": false,
      "description": "An explicitly supplied measurement, specification or planning assumption.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "enum": [
            "unknown",
            "measured",
            "supplier_specification",
            "assumed"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "unit",
        "basis"
      ],
      "title": "EngineeringValue",
      "type": "object"
    },
    "InvestmentComparisonInput": {
      "additionalProperties": false,
      "description": "Comparable outputs, annual demand and a no-replacement analysis horizon.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "baseline": {
          "$ref": "#/$defs/InvestmentOption"
        },
        "candidate": {
          "$ref": "#/$defs/InvestmentOption"
        },
        "equivalence_verified": {
          "default": false,
          "title": "Equivalence Verified",
          "type": "boolean"
        },
        "equivalence_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equivalence Source"
        },
        "annual_demand": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "horizon_years": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/SensitivityScenario"
          },
          "title": "Scenarios",
          "type": "array"
        }
      },
      "required": [
        "baseline",
        "candidate",
        "annual_demand",
        "horizon_years"
      ],
      "title": "InvestmentComparisonInput",
      "type": "object"
    },
    "InvestmentOption": {
      "additionalProperties": false,
      "description": "A process option with disjoint variable, fixed and upfront cost boundaries.",
      "properties": {
        "process": {
          "$ref": "#/$defs/ProcessEvaluationInput"
        },
        "cost_model_source": {
          "minLength": 1,
          "title": "Cost Model Source",
          "type": "string"
        },
        "capacity_model_source": {
          "minLength": 1,
          "title": "Capacity Model Source",
          "type": "string"
        },
        "upfront": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "title": "Upfront",
          "type": "object"
        },
        "annual_fixed_cost": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "scheduled_hours": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "utilization": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "downtime": {
          "$ref": "#/$defs/EngineeringValue"
        },
        "useful_life": {
          "$ref": "#/$defs/EngineeringValue"
        }
      },
      "required": [
        "process",
        "cost_model_source",
        "capacity_model_source",
        "annual_fixed_cost",
        "scheduled_hours",
        "utilization",
        "downtime",
        "useful_life"
      ],
      "title": "InvestmentOption",
      "type": "object"
    },
    "PredictionRequest": {
      "additionalProperties": false,
      "description": "A process prediction with optional matching investment comparison.",
      "properties": {
        "process": {
          "$ref": "#/$defs/ProcessEvaluationInput"
        },
        "investment": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvestmentComparisonInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "conditions": {
          "minLength": 1,
          "title": "Conditions",
          "type": "string"
        },
        "tolerances": {
          "additionalProperties": {
            "$ref": "#/$defs/DeviationTolerance"
          },
          "title": "Tolerances",
          "type": "object"
        }
      },
      "required": [
        "process",
        "conditions"
      ],
      "title": "PredictionRequest",
      "type": "object"
    },
    "ProcessEvaluationInput": {
      "additionalProperties": false,
      "description": "One batch with explicit units, boundary and acceptance provenance.\n\nMissing inputs remain unknown. Attendance intervals or an aggregate labor\nvalue may be supplied, never both. Rates must match the report's USD currency.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "configuration_id": {
          "minLength": 1,
          "title": "Configuration Id",
          "type": "string"
        },
        "functional_unit": {
          "minLength": 1,
          "title": "Functional Unit",
          "type": "string"
        },
        "boundary": {
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "acceptance_verified": {
          "default": false,
          "title": "Acceptance Verified",
          "type": "boolean"
        },
        "acceptance_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Source"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "attendance": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AttendanceInterval"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance"
        },
        "attendance_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance Source"
        }
      },
      "required": [
        "configuration_id",
        "functional_unit",
        "boundary"
      ],
      "title": "ProcessEvaluationInput",
      "type": "object"
    },
    "SensitivityScenario": {
      "additionalProperties": false,
      "description": "Named, sourced overrides to the same underlying investment comparison.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/EngineeringValue"
          },
          "minProperties": 1,
          "title": "Overrides",
          "type": "object"
        }
      },
      "required": [
        "name",
        "overrides"
      ],
      "title": "SensitivityScenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Explicit proposed changes responding to a recorded outcome.",
  "properties": {
    "prediction": {
      "$ref": "#/$defs/PredictionRequest"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "proposed_changes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Proposed Changes",
      "type": "array"
    }
  },
  "required": [
    "prediction",
    "rationale",
    "proposed_changes"
  ],
  "title": "RevisionRequest",
  "type": "object"
}
